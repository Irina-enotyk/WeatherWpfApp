<Window x:Class="WeatherWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:homeView="clr-namespace:WeatherWpfApp.Views.Home"
        xmlns:vm="clr-namespace:WeatherWpfApp.ViewModels"
        xmlns:local="clr-namespace:WeatherWpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="935">
    <Window.Resources>
        <Style x:Key="LeftPanelButton" TargetType="Button">
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height =' auto'/>
            <RowDefinition Height =' 1*'/>
            <RowDefinition Height =' 10*'/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Label 
                       Content="Прогноз"
                       Margin="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
                </Grid>

                <Grid Grid.Column="1">
                    <Label 
                       Content="Погода"
                       Margin="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
                </Grid>
                <Grid Grid.Column="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label x:Name="userNameLabel"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>
                    <Button x:Name="signOutButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        Content="Выйти"/>
                    <Button x:Name="registrationButton"
                        Grid.Row="1"
                        Grid.Column="0" 
                        Margin="5" 
                        Content="Регистрация"/>
                    <Button x:Name="signInButton"
                        Grid.Row="1"
                        Grid.Column="1" 
                        Margin="5" 
                        Content="Войти"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34*"/>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="19*"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Width="Auto"
                    Margin="5,5,0,5"
                    HorizontalAlignment="Left"
                    Content=" Обновить "/>
                <Label
                    Grid.Column="1"
                    Width="Auto"
                    Margin="112,5,0,5"
                    HorizontalAlignment="Left"
                    Content="Период прогноза погоды" Grid.ColumnSpan="2"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column ="0" Orientation="Vertical">
                <Button
                    Content="Home"
                    Style="{StaticResource LeftPanelButton}"
                    Command="{Binding Path=HomeCommand}"/>
                <Button Content="Location" Style="{StaticResource LeftPanelButton}"/>
                <Button Content="Settings" Style="{StaticResource LeftPanelButton}"/>
                <Button Content="Close" Style="{StaticResource LeftPanelButton}"/>
            </StackPanel>

            <!--Здесь нужно вставить домашнее окно-->
            <Grid Grid.Column="1">
                <homeView:HomeView DataContext="{Binding HomeViewViewModel}"/>
            </Grid>
            
        </Grid>
    </Grid>
</Window>
