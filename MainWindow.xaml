<Window x:Class="WeatherWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherWpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="850">
    <Window.Resources>
        <Style x:Key="LeftPanelButton" TargetType="Button">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height =' 1*'/>
            <RowDefinition Height =' 1*'/>
            <RowDefinition Height =' 10*'/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Label 
                       Content="Прогноз"
                       Margin="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>       
                </Grid>
                
                <Grid Grid.Column="1">
                    <Label 
                       Content="Погода"
                       Margin="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>       
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                           Content="Кабинет"
                           Margin="5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                    <Label Grid.Column="1"
                           Content="Имя"
                           Margin="5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                    <Button Grid.Column="2" Margin="5" Content="Регистрация"/>
                    <Button Grid.Column="3" Margin="5" Content="Войти"/>
                    <Button Grid.Column="4" Margin="5" Content="Выйти"/>
                </Grid>

            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <Button
                    Grid.Column="0"
                    Width="Auto"
                    Margin="5"
                    HorizontalAlignment="Left"
                    Content=" Обновить "/>
                <Label
                    Grid.Column="1"
                    Width="Auto"
                    Margin="5"
                    HorizontalAlignment="Center"
                    Content="Период прогноза погоды"/>
                
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column ="0" Orientation="Vertical">
                <Button Content="Home" Style="{StaticResource LeftPanelButton}"/>
                <Button Content="Location" Style="{StaticResource LeftPanelButton}"/>
                <Button Content="Settings" Style="{StaticResource LeftPanelButton}"/>
                <Button Content="Close" Style="{StaticResource LeftPanelButton}"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="Details_StackPanel" Grid.Column="0" Orientation="Vertical">
                        <Label Content="{Binding Path=Date}"/>
                        <Label Content="{Binding Path=MaxTemperature}"/>
                        <Label Content="{Binding Path=MinTemperature}"/>
                    </StackPanel>

                </Grid>

                <ListBox x:Name="WeatherDays_ListBox" Grid.Row="1">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Click="WeatherDayButton_Click">
                                <StackPanel Orientation="Vertical">
                                    <Label Content="{Binding Path=Date}"/>
                                    <Label Content="{Binding Path=MaxTemperature}"/>
                                    <Label Content="{Binding Path=MinTemperature}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
