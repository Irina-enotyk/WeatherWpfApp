<Window x:Class="WeatherWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:homeView="clr-namespace:WeatherWpfApp.Views.Home"
        xmlns:locationView="clr-namespace:WeatherWpfApp.Views.Location"
        xmlns:settingsView="clr-namespace:WeatherWpfApp.Views.Settings"
        xmlns:vm="clr-namespace:WeatherWpfApp.ViewModels"
        xmlns:local="clr-namespace:WeatherWpfApp"
        xmlns:converters="clr-namespace:WeatherWpfApp.Resources.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="935"
        FontFamily="{StaticResource MainFont}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <DataTemplate DataType="{x:Type vm:HomeViewViewModel}">
            <homeView:HomeView DataContext="{Binding}"/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:LocationViewViewModel}">
            <locationView:LocationView DataContext="{Binding}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewViewModel}">
            <settingsView:SettingsView DataContext="{Binding}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource MainWindowBackGround}">
        
        <Grid.RowDefinitions>
            <RowDefinition Height =' auto'/>
            <RowDefinition Height =' 1*'/>
            <RowDefinition Height =' 10*'/>
        </Grid.RowDefinitions>

        <Grid 
            Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Label 
                       Content="{DynamicResource DateHeader}"
                       Margin="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
                </Grid>

                <Grid Grid.Column="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label x:Name="userNameLabel"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding UserNameLabelIsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Content="{Binding UserName}"
                        />
                    <Button x:Name="signOutButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        Content="{DynamicResource SignOut}"
                        Visibility="{Binding SignOutButtonIsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Command="{Binding SignOutCommand}"/>
                    <Button x:Name="registrationButton"
                        Grid.Row="1"
                        Grid.Column="0" 
                        Margin="5" 
                        Content="{DynamicResource Register}"
                        Visibility="{Binding RegisterButtonIsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Command="{Binding RegisterCommand}"/>
                    <Button x:Name="signInButton"
                        Grid.Row="1"
                        Grid.Column="1" 
                        Margin="5" 
                        Content="{DynamicResource SignIn}"
                        Visibility="{Binding SignInButtonIsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Command="{Binding SignInCommand}"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34*"/>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="19*"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Width="Auto"
                    Margin="5,5,0,5"
                    HorizontalAlignment="Left"
                    Content="{DynamicResource Update}"/>
                <Label
                    Grid.Column="1"
                    Width="Auto"
                    Margin="112,5,0,5"
                    HorizontalAlignment="Left"
                    Content="{DynamicResource WeatherPeriod}"
                    Grid.ColumnSpan="2"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <StackPanel 
                Grid.Column ="0"
                Orientation="Vertical">
                <Button
                    Content="{DynamicResource HomeTitle}"
                    Style="{StaticResource LeftPanelButton}"
                    Command="{Binding HomeCommand}"/>
                <Button
                    Content="{DynamicResource LocationsTitle}"
                    Style="{StaticResource LeftPanelButton}"
                    Command="{Binding LocationCommand}"/>
                <Button 
                    Content="{DynamicResource SettingsTitle}"
                    Style="{StaticResource LeftPanelButton}"
                    Command="{Binding SettingsCommand}"/>
                <Button
                    Content="{DynamicResource Exit}" 
                    Style="{StaticResource LeftPanelButton}"
                    Command="{Binding CloseCommand}"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <ContentControl Content="{Binding SelectedContent}"/>
            </Grid>
            
        </Grid>
    </Grid>
</Window>
