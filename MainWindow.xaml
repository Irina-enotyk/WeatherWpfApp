<Window x:Class="WeatherWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherWpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1300">
    <Window.Resources>
        <Style x:Key="LeftPanelButton" TargetType="Button">
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height =' auto'/>
            <RowDefinition Height =' 1*'/>
            <RowDefinition Height =' 10*'/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Label 
                       Content="Прогноз"
                       Margin="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>       
                </Grid>
                
                <Grid Grid.Column="1">
                    <Label 
                       Content="Погода"
                       Margin="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>       
                </Grid>
                <Grid Grid.Column="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label x:Name="userNameLabel"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>
                    <Button x:Name="signOutButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        Content="Выйти"/>
                    <Button x:Name="registrationButton"
                        Grid.Row="1"
                        Grid.Column="0" 
                        Margin="5" 
                        Content="Регистрация"/>
                    <Button x:Name="signInButton"
                        Grid.Row="1"
                        Grid.Column="1" 
                        Margin="5" 
                        Content="Войти"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <Button
                    Grid.Column="0"
                    Width="Auto"
                    Margin="5"
                    HorizontalAlignment="Left"
                    Content=" Обновить "/>
                <Label
                    Grid.Column="1"
                    Width="Auto"
                    Margin="5"
                    HorizontalAlignment="Center"
                    Content="Период прогноза погоды"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column ="0" Orientation="Vertical">
                <Button Content="Home" Style="{StaticResource LeftPanelButton}"/>
                <Button Content="Location" Style="{StaticResource LeftPanelButton}"/>
                <Button Content="Settings" Style="{StaticResource LeftPanelButton}"/>
                <Button Content="Close" Style="{StaticResource LeftPanelButton}"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="Details_StackPanel" Grid.Column="0" Orientation="Vertical">
                        <Label Content="{Binding Path=Date}"/>
                        <Label Content="{Binding Path=MaxTemperature}"/>
                        <Label Content="{Binding Path=MinTemperature}"/>
                    </StackPanel>

                </Grid>

                <ListBox x:Name="WeatherDays_ListBox" Grid.Row="1">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Click="WeatherDayButton_Click">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column ="0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Label Content="{Binding Path=Date}"/>
                                                </Grid>
                                                <Grid Grid.Row="1">
                                                    <Label Content="{Binding Path=WeekDay}"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                        <Grid Grid.Column ="1"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center">
                                            <Image 
                                                Source="/Image/weather-forcast-storm-rain-thunder-day_108615.png"
                                                Width="32"
                                                Height="32"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Label Content="{Binding Path=MaxTemperature}"/>
                                        </Grid>
                                        <Grid Grid.Column="1">
                                            <Label Content="{Binding Path=MinTemperature}"/>
                                        </Grid>
                                    </Grid>
                                    <Label Content="{Binding Path=Weather}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
