<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="MainWindowBackGround">
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0" Color="Coral"/>
            <GradientStop Offset="1" Color="#FFC371"/>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
    
    

    <SolidColorBrush 
        x:Key="MainMenuButtonBackground"
        Color="White"
        Opacity="0.25"/>
    <SolidColorBrush 
        x:Key="LightBackground" 
        Color="White"
        Opacity="1"/>
    <SolidColorBrush 
        x:Key="HourlyForcastHeaderBackground" 
        Color="LimeGreen"
        Opacity="0.5"/>
    <SolidColorBrush 
        x:Key="HourlyForcastDataBackground" 
        Color="LightGreen"
        Opacity="0.35"/>

    <SolidColorBrush x:Key="MainForeground" Color="Black"/>
    <SolidColorBrush x:Key="PagesTipsForeground" Color="White"/>
</ResourceDictionary>