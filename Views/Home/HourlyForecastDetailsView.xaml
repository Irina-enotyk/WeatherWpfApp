<UserControl x:Class="WeatherWpfApp.Views.Home.HourlyForecastDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherWpfApp.Views.Home"
             xmlns:model="clr-namespace:WeatherWpfApp.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="CellStyle">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <UserControl.DataContext>
        <model:DayForecastModel/>
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0"
               Content="Почасовой прогноз"
               VerticalAlignment="Center"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row ="0"
                    BorderThickness="1"
                    BorderBrush="DimGray"
                    Background="LightGoldenrodYellow">
            </Border>
            <Grid Grid.Row="0" Margin="0, 0, 20, 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                    Grid.Column="0"
                    HorizontalAlignment="Center" 
                    Text="Время"/>
                <TextBlock 
                    Grid.Column="1" 
                    HorizontalAlignment="Center"
                    Text="Изобр"/>
                <TextBlock 
                    Grid.Column="2" 
                    HorizontalAlignment="Center"
                    Text="ТМакс"/>
                <TextBlock 
                    Grid.Column="3" 
                    HorizontalAlignment="Center"
                    Text="ТМин"/>
                <TextBlock 
                    Grid.Column="4" 
                    HorizontalAlignment="Center"
                    Text="Осадки"/>
                <TextBlock 
                    Grid.Column="5" 
                    HorizontalAlignment="Center"
                    Text="Давление"/>
                <TextBlock 
                    Grid.Column="6" 
                    HorizontalAlignment="Center"
                    Text="Ветер"/>
            </Grid>
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding HourlyForecast}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>  
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock 
                                    Grid.Column="0" 
                                    Style ="{StaticResource CellStyle}" 
                                    Text="{Binding Time}"/>
                                <TextBlock 
                                    Grid.Column="1" 
                                    Style ="{StaticResource CellStyle}" 
                                    Text=""/>
                                <TextBlock 
                                    Grid.Column="2" 
                                    Style ="{StaticResource CellStyle}" 
                                    Text="{Binding Temperature}"/>
                                <TextBlock 
                                    Grid.Column="3" 
                                    Style ="{StaticResource CellStyle}" 
                                    Text="{Binding ApparentTemperature}"/>
                                <TextBlock 
                                    Grid.Column="4" 
                                    Style ="{StaticResource CellStyle}" 
                                    Text="{Binding RelativeHumidity}"/>
                                <TextBlock 
                                    Grid.Column="5" 
                                    Style ="{StaticResource CellStyle}" 
                                    Text="{Binding SurfasePressure}"/>
                                <TextBlock 
                                    Grid.Column="6" 
                                    Style ="{StaticResource CellStyle}" 
                                    Text="{Binding WindSpeed}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
