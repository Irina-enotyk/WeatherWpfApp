<UserControl x:Class="WeatherWpfApp.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherWpfApp.Views.Settings"
             xmlns:vm="clr-namespace:WeatherWpfApp.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:SettingsViewViewModel/>
    </UserControl.DataContext>
    
    <Grid>
        <StackPanel HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Настройки"/>
            <TextBox/>
            <TextBlock Text="Системные настройки"/>
            <TextBox/>
        </StackPanel>
            
    </Grid>
</UserControl>
