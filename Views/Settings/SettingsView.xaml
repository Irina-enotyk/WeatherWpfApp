<UserControl x:Class="WeatherWpfApp.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherWpfApp.Views.Settings"
             xmlns:vm="clr-namespace:WeatherWpfApp.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel 
            HorizontalAlignment="Center"
            Width="300"
            >
            <TextBlock Text="Температура"/>
            <ComboBox
                ItemsSource="{Binding TemperatureMeasures}"
                SelectedItem="{Binding TemperatureMeasure}"
                />
            <TextBlock Text="Язык приложения"/>
            <ComboBox
                ItemsSource="{Binding Cultures}"
                SelectedItem="{Binding Culture}"/>
        </StackPanel>
    </Grid>
</UserControl>
