<Window x:Class="WeatherWpfApp.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherWpfApp"
        xmlns:vm="clr-namespace:WeatherWpfApp.ViewModels.Auth"
        mc:Ignorable="d"
        Title=""
        Height="400" 
        Width="350"
        >
    <Window.DataContext>
        <vm:SignInWindowViewModel/>
    </Window.DataContext>   
    
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label
                x:Name="titleLabel"
                Grid.Row="0"
                Content="Вход"
                FontSize="20"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
            />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Label
                    x:Name="loginLabel"
                    Content="Логин"
                    FontSize="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="5"
                />

                <TextBox
                    x:Name="loginTextBox"
                    Grid.Column="1"
                    Margin="5"
                    Width="200"
                    FontSize="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Text="{Binding Login}"
                />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Label
                    x:Name="passwordLabel"
                    Content="Пароль"
                    FontSize="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right" 
                    Margin="5"
                />

            <TextBox
                x:Name="passwordPasswordBox"
                Grid.Column="1"
                Margin="5"
                Width="200"
                FontSize="20"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Text="{Binding Password}"
                />
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="131*"/>
                </Grid.ColumnDefinitions>

                <CheckBox
                    x:Name="rememberMeCheckBox"
                    Grid.Column="0"
                    FontSize="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="5"
                    IsChecked="{Binding RememberMe}"
                />

            <Label
                x:Name="rememberMeLabel"
                Grid.Column="1"
                Content="Запомнить меня"
                FontSize="20"
                VerticalAlignment="Center"
                HorizontalAlignment="Left" 
                Margin="5"
                />
        </Grid>

            <Button
                Grid.Row="4"
                Content="Войти"
                FontSize="20"
                Margin="10"
                Command="{Binding SignInCommand}"
            />
        </Grid>
</Window>

