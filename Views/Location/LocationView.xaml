<UserControl x:Class="WeatherWpfApp.Views.Location.LocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherWpfApp.Views.Location"
             xmlns:vm="clr-namespace:WeatherWpfApp.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Disabled"    >
            <StackPanel HorizontalAlignment="Center">
                <ComboBox
                    IsEditable="True"
                    IsTextSearchEnabled="True"
                    Text="{Binding LocationSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding SearchResults}"
                    SelectedItem="{Binding SelectedLocation}">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource MainForeground}"
                                           FontSize="15"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="{Binding SelectLocation}"
                           Foreground="{DynamicResource PagesTipsForeground}"
                           FontSize="15"/>

                <Border 
                    Background="{DynamicResource PagesTipsForeground}"
                    Margin="0, 5, 0, 0"
                    Padding="15, 10"
                    CornerRadius="10">

                    <TextBlock
                        Text="{Binding SelectedLocation.Name}"
                        Foreground="{DynamicResource MainForeground}"
                        FontSize="15"
                        Margin="0, 0, 0, 0"
                        VerticalAlignment="Center">
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
    </Grid>
</UserControl>
